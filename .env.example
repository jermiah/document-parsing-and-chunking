# Copy to .env and fill in credentials supplied separately.
# The private .env is excluded from Git and Docker images.
# Supabase session pooler URL: postgresql+psycopg://<user>:<encoded-password>@<host>:5432/postgres?sslmode=require
DATABASE_URL=
STORAGE_BACKEND=supabase
SUPABASE_URL=https://fctgqpxhufjotwlenjxg.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=document-ingestion
CONFIG_PATH=configs/default.yaml
# For image annotations, use configs/openai.yaml and supply the key privately.
OPENAI_API_KEY=
DATA_DIR=data
ARTIFACT_DIR=artifacts
REPORT_DIR=reports

# Local PostgreSQL alternative: see README Option 2.
# Use compose.local.yaml, set STORAGE_BACKEND=local, and clear Supabase keys.
# Host Python DATABASE_URL: postgresql+psycopg://rag:rag@localhost:5432/rag
# Local Compose sets the API connection to db:5432 automatically.
